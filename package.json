{
  "name": "ensemble",
  "version": "0.1.0",
  "private": true,
  "description": "Ensemble — gestion du bénévolat scolaire (monorepo pnpm)",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @ensemble/db generate",
    "db:migrate": "pnpm --filter @ensemble/db migrate",
    "db:seed": "pnpm --filter @ensemble/db seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
