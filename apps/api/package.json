    "nodemailer": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.6.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0",
    "wrangler": "^4.108.0"
