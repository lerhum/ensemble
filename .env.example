# ─────────────────────────────────────────────────────────────
# Ensemble — variables d'environnement (copier vers .env)
# `docker compose up` lit ce fichier via env_file/variables.
# ─────────────────────────────────────────────────────────────

# --- Postgres (service db Docker) ---
POSTGRES_USER=ensemble
POSTGRES_PASSWORD=ensemble
POSTGRES_DB=ensemble

# Chaîne de connexion utilisée par api + migrate (host "db" = service Docker).
# En prod (Cloudflare Worker), remplacer par l'URL Neon (voir DEPLOY.md).
DATABASE_URL=postgres://ensemble:ensemble@db:5432/ensemble

# Driver Drizzle : "node" (Postgres local via pg) ou "neon" (Worker/Neon serverless).
DB_DRIVER=node

# --- API ---
API_PORT=8787
# Secret de signature des cookies de session (CHANGER en prod).
SESSION_SECRET=dev-secret-change-me-please-32chars-min
# Origine autorisée pour CORS (le front en dev).
WEB_ORIGIN=http://localhost:5173

# --- Web ---
WEB_PORT=5173
# Base de l'API vue par le proxy Vite (côté conteneur web → service api).
VITE_API_PROXY=http://api:8787
